<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="100dp"
    android:viewportWidth="320"
    android:viewportHeight="100">

    <!-- Dark background -->
    <path android:pathData="M0,0 h320 v100 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="100"
                android:type="linear">
                <item android:color="#FF0A0A0A" android:offset="0.0"/>
                <item android:color="#FF1A1A1A" android:offset="0.5"/>
                <item android:color="#FF0A0A0A" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orange accent line top -->
    <path android:pathData="M0,2 L320,2"
        android:strokeWidth="3"
        android:strokeColor="#FFFF9100"
        android:fillColor="#00000000"/>

    <!-- Orange accent line bottom -->
    <path android:pathData="M0,98 L320,98"
        android:strokeWidth="3"
        android:strokeColor="#FFFF9100"
        android:fillColor="#00000000"/>

    <!-- Stylized K logo - white with wave design -->
    <!-- K vertical stroke -->
    <path android:pathData="M30,25 L30,75 L38,75 L38,50 L55,75 L65,75 L47,47 L65,25 L55,25 L40,42 L38,45 L38,25 Z"
        android:fillColor="#FFFFFFFF"/>

    <!-- K wave accent -->
    <path android:pathData="M26,25 C26,25 29,35 30,45 C31,55 29,65 30,75"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFFFF"
        android:fillColor="#00000000"
        android:strokeLineCap="round"/>

    <!-- K inner wave detail -->
    <path android:pathData="M28,30 C28,30 31,40 33,50 C35,60 33,68 34,73"
        android:strokeWidth="1"
        android:strokeColor="#FFFF9100"
        android:fillColor="#00000000"
        android:strokeLineCap="round"/>

    <!-- Text: KUZMIX OS -->
    <!-- K -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M90,35 h4 v30 h-4 Z M94,47 L104,35 h6 L99,50 L108,65 h-6 L94,49 Z"/>
    <!-- U -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M115,35 h5 v25 c0,4 -2,5 -5,5 s-5,-1 -5,-5 v-25 h5 v25 c0,1 0,2 1,2 s1,-1 1,-2 z"/>
    <!-- Z -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M128,35 h8 l-7,28 h-8 z"/>
    <!-- M -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M143,35 h4 l6,18 l6,-18 h4 v30 h-4 v-20 l-5,15 h-4 l-5,-15 v20 h-4 z"/>
    <!-- I -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M168,35 h4 v30 h-4 z"/>
    <!-- X -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M182,35 l7,15 l7,-15 h5 l-9,17 l9,13 h-5 l-7,-12 l-7,12 h-5 l9,-13 l-9,-17 z"/>

    <!-- Orange dot separator -->
    <path android:pathData="M207,50m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0"
        android:fillColor="#FFFF9100"/>

    <!-- O -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M220,35 c6,0 10,4 10,10 v10 c0,6 -4,10 -10,10 s-10,-4 -10,-10 v-10 c0,-6 4,-10 10,-10 z M220,38 c-4,0 -6,3 -6,6 v12 c0,3 2,6 6,6 s6,-3 6,-6 v-12 c0,-3 -2,-6 -6,-6 z"/>
    <!-- S -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M242,35 h8 c3,0 5,2 5,5 c0,2 -1,3 -3,4 l4,5 c2,-1 4,-3 4,-6 c0,-5 -4,-8 -8,-8 h-6 v3 h6 c2,0 3,1 3,3 s-1,3 -3,3 h-5 v3 h6 c2,0 3,1 3,3 s-1,3 -3,3 h-8 z"/>

    <!-- Subtle glow behind K -->
    <path android:pathData="M47,50m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="27"
                android:startY="30"
                android:endX="67"
                android:endY="70"
                android:type="radial"
                android:gradientRadius="30">
                <item android:color="#20FF9100" android:offset="0.0"/>
                <item android:color="#00000000" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
